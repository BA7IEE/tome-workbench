# Do not reuse any SRVF database, storage or secret. Local-only defaults.
APP_ENV=development
HOST=127.0.0.1
PORT=4318
APP_ORIGIN=http://127.0.0.1:4318
DATABASE_URL=postgresql://tome:CHANGE_ME@127.0.0.1:55438/tome_dev?schema=public
MEDIA_DIR=./data/media
COOKIE_SECURE=false
EXTERNAL_EFFECTS_ENABLED=false
# Standard Handoff never needs claim/lease endpoints. Keep their legacy
# compatibility surface off unless a separately reviewed migration needs it.
DISTRIBUTION_COMPAT_RUNTIME_ENABLED=false
# A delivered standard Handoff becomes a read-only ATTENTION projection after
# this many hours. It never changes or retries the underlying Attempt.
DISTRIBUTION_HANDOFF_STALE_HOURS=24
# There is no live marketplace/payment adapter in this release.
AI_ENABLED=false
# AI is opt-in, server-configured, and never necessary to operate the core.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
