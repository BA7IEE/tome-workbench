{
  "name": "tome-workbench",
  "version": "1.0.0-rc.17",
  "private": true,
  "license": "UNLICENSED",
  "description": "兔泥巴商品资料库：永久TM、批量导入、原图维护与运营资料交接",
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:api && npm run build:web",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev": "npm run build:api && node --watch dist/main.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "setup:admin": "node dist/cli.js admin",
    "demo:seed": "node dist/cli.js demo",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src web/src test scripts --max-warnings 0",
    "format": "prettier --write src web/src test scripts prisma/schema.prisma README.md --ignore-unknown",
    "test:unit": "node --test test/unit.test.cjs",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.cjs",
    "test:browser": "playwright test",
    "harness:check": "node scripts/harness.mjs",
    "harness:selftest": "node --test test/harness.test.cjs",
    "harness:full": "npm run check:syntax && npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run harness:selftest && npm run test:integration && npm run test:browser && npm run test:browser:webkit && npm run test:ha && npm run test:recovery && npm run harness:check",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "pack": "node scripts/package.mjs",
    "start:resilient": "node scripts/cluster.mjs",
    "test:ha": "node --test --test-concurrency=1 test/high-availability.test.mjs",
    "test:recovery": "node scripts/verify-recovery.mjs",
    "check:syntax": "node scripts/validate-syntax.mjs",
    "deploy:check": "node scripts/production-preflight.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:browser:webkit": "playwright test -c playwright.webkit.config.cjs"
  },
  "dependencies": {
    "@arco-design/web-react": "2.66.16",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "archiver": "7.0.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.1.0",
    "pg": "8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/archiver": "6.0.3",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.17",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vite": "7.3.6"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "deepmerge-ts": "8.0.0",
    "multer": "2.3.0"
  }
}
